    {
      "key": "DEC-001",
      "kind": "decision",
      "title": "เกณฑ์ตัดสินว่าบริการ “ทำงาน”",
      "body": {
        "rule": "นับ HTTP 2xx และ 3xx ว่า “ทำงาน”; 4xx, 5xx, ข้อผิดพลาดเครือข่าย หรือไม่ตอบภายใน 3 วินาที เป็น “ไม่ตอบ”",
        "cases": [
          "2xx (200/204) → ทำงาน",
          "3xx (301/302) → ทำงาน",
          "4xx (401/404) → ไม่ตอบ",
          "5xx (500) → ไม่ตอบ",
          "connection refused หรือเกิน 3 วินาที → ไม่ตอบ"
        ],
        "neighbouring": "การยิงตรวจพร้อมกันหรือเรียงลำดับไม่มีผลต่อเกณฑ์นี้"
      },
      "origin": {
        "date": "2026-10-30",
        "stamp": "team-proposed"
      },
      "createdIn": "ea4128ab-e35e-44e6-a1ce-bd2bad11b2d3"
    },
