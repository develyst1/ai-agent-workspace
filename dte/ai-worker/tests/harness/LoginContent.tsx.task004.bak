'use client';

import { useState, useEffect } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import Link from 'next/link';
import { App } from 'antd';
import { Lightbulb, Send } from 'lucide-react';
import { useAuth } from '@/contexts/AuthContext';
import { authApi } from '@/services/api';
import { BaseButton } from '@/components/ui/Button';
import { BaseCheckbox } from '@/components/ui/Checkbox';
import { BaseInput } from '@/components/ui/Input';

function LoginForm() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState('');
  const [needsVerification, setNeedsVerification] = useState(false);
  const [resendLoading, setResendLoading] = useState(false);
  const { login, isAuthenticated } = useAuth();
  const { message } = App.useApp();
  const router = useRouter();
  const searchParams = useSearchParams();
  const redirectTo = searchParams.get('redirect') || '/';

  useEffect(() => {
    if (isAuthenticated) {
      router.push(redirectTo);
    }
  }, [isAuthenticated, router, redirectTo]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setNeedsVerification(false);
    setIsLoading(true);

    try {
      const success = await login(email, password);
      if (success) {
        router.push(redirectTo);
      } else {
        setError('อีเมลหรือรหัสผ่านไม่ถูกต้อง');
      }
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง';
      setError(errorMessage);

      // Check if error is about email verification
      if (errorMessage.includes('ยืนยันอีเมล') || errorMessage.includes('verify')) {
        setNeedsVerification(true);
      }

      console.error('Login error:', err);
    } finally {
      setIsLoading(false);
    }
  };

  const handleResendVerification = async () => {
    if (!email) {
      message.warning('กรุณากรอกอีเมลของคุณก่อน');
      return;
    }

    setResendLoading(true);
    try {
      const data = await authApi.resendVerification(email);
      message.success(data.message || 'ส่งอีเมลยืนยันใหม่เรียบร้อยแล้ว');
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'เกิดข้อผิดพลาดในการส่งอีเมล';
      message.error(errorMessage);
    } finally {
      setResendLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-theme-primary flex items-center justify-center px-4 py-12 relative overflow-hidden">
      {/* Background Decoration */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        <div className="absolute top-20 left-10 w-72 h-72 bg-sky-400/10 rounded-full blur-3xl animate-float-slow" />
        <div className="absolute bottom-20 right-10 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl animate-float-medium" />
      </div>

      <div className="max-w-md w-full relative z-10">
        {/* Header */}
        <div className="text-center mb-8 animate-fade-in-up">
          <Link href="/" className="inline-block">
            <h1 className="text-4xl font-bold bg-gradient-to-r from-sky-600 to-cyan-600 bg-clip-text text-transparent mb-2">
              DTE
            </h1>
          </Link>
          <p className="text-theme-secondary mt-2">เข้าสู่ระบบเพื่อเริ่มต้นเรียนรู้</p>
        </div>

        {/* Login Form */}
        <div className="bg-theme-secondary rounded-2xl shadow-xl p-8 border border-theme-primary animate-fade-in-up glass-effect" style={{ animationDelay: '0.2s' }}>
          <form onSubmit={handleSubmit} className="space-y-6">
            {error && (
              <div className="bg-red-500/10 border border-red-500/50 text-red-500 px-4 py-3 rounded-lg text-sm animate-fade-in">
                {error}

                {/* Show resend button if needs verification */}
                {needsVerification && (
                  <BaseButton
                    danger
                    block
                    onClick={handleResendVerification}
                    loading={resendLoading}
                    disabled={resendLoading}
                    icon={<Send size={16} />}
                    className="mt-3"
                  >
                    {resendLoading ? 'กำลังส่ง...' : 'ส่งอีเมลยืนยันอีกครั้ง'}
                  </BaseButton>
                )}
              </div>
            )}

            <div>
              <label htmlFor="email" className="block text-sm font-medium text-theme-primary mb-2">
                อีเมล
              </label>
              <BaseInput
                id="email"
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                required
                className="w-full"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label htmlFor="password" className="block text-sm font-medium text-theme-primary mb-2">
                รหัสผ่าน
              </label>
              <BaseInput
                id="password"
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                required
                className="w-full"
                placeholder="••••••••"
              />
            </div>

            <div className="flex items-center justify-between text-sm">
              <BaseCheckbox className="text-theme-secondary">จดจำฉัน</BaseCheckbox>
              <Link href="/forgot-password" className="text-sky-600 hover:text-sky-500 transition-colors">
                ลืมรหัสผ่าน?
              </Link>
            </div>

            <BaseButton
              type="primary"
              htmlType="submit"
              block
              loading={isLoading}
              disabled={isLoading}
              className="font-semibold"
            >
              {isLoading ? 'กำลังเข้าสู่ระบบ...' : 'เข้าสู่ระบบ'}
            </BaseButton>
          </form>

          <div className="mt-6 text-center">
            <p className="text-sm text-theme-secondary">
              ยังไม่มีบัญชี?{' '}
              <Link href={`/register${searchParams.get('redirect') ? `?redirect=${searchParams.get('redirect')}` : ''}`} className="text-sky-600 hover:text-sky-500 font-semibold transition-colors">
                สมัครฟรีเลย
              </Link>
            </p>
          </div>

          {/* Demo Credentials */}
          <div className="mt-6 pt-6 border-t border-theme-primary">
            <p className="text-xs text-theme-tertiary text-center mb-2">
              <Lightbulb size={14} className="inline-block mr-1" aria-hidden /> ทดสอบด้วยบัญชีตัวอย่าง: john@example.com / password123
            </p>
          </div>
        </div>

        {/* Social Login */}
        <div className="mt-6 animate-fade-in-up" style={{ animationDelay: '0.4s' }}>
          <div className="relative">
            <div className="absolute inset-0 flex items-center">
              <div className="w-full border-t border-theme-primary"></div>
            </div>
            <div className="relative flex justify-center text-sm">
              <span className="px-4 bg-theme-primary text-theme-secondary">หรือเข้าสู่ระบบด้วย</span>
            </div>
          </div>

          <div className="mt-6 grid grid-cols-2 gap-3">
            <BaseButton block size="large">
              <svg className="w-5 h-5 mr-2" viewBox="0 0 24 24">
                <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span className="text-theme-primary font-medium">Google</span>
            </BaseButton>
            <BaseButton block size="large">
              <svg className="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span className="text-theme-primary font-medium">Facebook</span>
            </BaseButton>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function LoginContent() {
  return (
    <App component={false}>
      <LoginForm />
    </App>
  );
}
